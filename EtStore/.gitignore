cd ~/EtStor

# Crie um .gitignore ESPECÍFICO para SSMS/Visual Studio
cat > .gitignore << 'EOF'
# SSMS 22 / Visual Studio
.vs/
*.sln
*.suo
*.user
*.sqlsuo
*.ssmssqlproj
*.ssmssqlproj.user

# Arquivos de soluções do SSMS
*.ssmssln

# Python
__pycache__/
*.pyc
venv/
env/

# Banco de Dados (arquivos binários)
*.mdf
*.ldf
*.bak
*.trn

# Sistema
.DS_Store
Thumbs.db

# Logs
*.log
EOF